# Documentation only. Run make dev-setup to generate .local/dev.env with
# fresh secrets. Do not use placeholder values or commit generated files.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8088
DATABASE_URL=postgresql://unihub:GENERATED_LOCALLY@127.0.0.1:55438/unihub?sslmode=disable
LEDGER_URL=http://127.0.0.1:53068
LEDGER_NAME=unihub
OIDC_ISSUER=http://localhost:58000
OIDC_AUDIENCE=unihub-local
# Public product clients may read account entitlements and issue model grants.
# Each audience must be distinct from the console and operator audiences.
OIDC_PRODUCT_CLIENTS=superwagie=superwagie-unihub-local
# Approved independent clients and scopes; JSON metadata contains no secrets.
# Audiences must also be separate from legacy product/console/operator clients.
PRODUCT_BILLING_FILE=
# Independent public commercial profiles; no IdP gate or credentials.
# See docs/composable-billing.md and examples/billing/.
PRODUCT_CLIENTS_FILE=
# Headless identity defaults disabled. Enable only after real audit privacy
# acceptance; see docs/headless-product-api.md and deploy/identity/README.md.
HEADLESS_IDENTITY_KEY=
HEADLESS_MANAGEMENT_CLIENT_ID=
HEADLESS_MANAGEMENT_CLIENT_SECRET=
HEADLESS_AUDIT_REDACTION_VERIFIED=false
# Only with a loopback reverse proxy replacing X-Real-IP with $remote_addr.
HEADLESS_TRUST_LOOPBACK_PROXY=false
# Omit PUBLIC_URL for API-only mode. Production requires an HTTPS origin.
PUBLIC_URL=http://localhost:8088
OIDC_CLIENT_SECRET=GENERATED_LOCALLY
CONSOLE_STATIC_DIR=web/dist
# Independent server credential for llmrouter's restricted billing API.
MODEL_SERVICE_TOKEN=GENERATED_LOCALLY_AT_LEAST_32_BYTES
SANDBOX_CATALOG=true
# UniHub user IDs, comma separated; empty grants no catalog operator access.
BILLING_OPERATOR_IDS=
# Database-backed platform authority is enabled by explicit bootstrap. These
# optional gates keep provider directory/recovery capabilities off until
# deployment-equivalent Casdoor acceptance is recorded.
ADMIN_IDENTITY_DEPLOYMENT_VERIFIED=false
ADMIN_PASSWORD_RESET_VERIFIED=false
ADMIN_SESSION_REVOCATION_VERIFIED=false
# Recovery/activation mail relay for the platform administration identity
# provider. ADMIN_PASSWORD_RESET_VERIFIED refuses to start without these.
RECOVERY_SMTP_ADDR=
RECOVERY_SMTP_FROM=
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
# A separate OIDC client audience for operator API tokens (not the console).
OPS_OIDC_AUDIENCE=
PAYMENT_MODE=sandbox
PAYMENT_MERCHANT=unihub-sandbox
PAYMENT_SIGNING_KEY=GENERATED_LOCALLY_AT_LEAST_32_BYTES

# Compose/bootstrap values are also generated in .local/dev.env.
POSTGRES_ADMIN_USER=unihub
POSTGRES_ADMIN_PASSWORD=GENERATED_LOCALLY
LEDGER_POSTGRES_URI=postgresql://unihub:GENERATED_LOCALLY@unihub-dev-postgres:5432/ledger?sslmode=disable
CASDOOR_DATABASE_PASSWORD=GENERATED_LOCALLY
LOCAL_GID=GENERATED_FROM_CURRENT_USER
