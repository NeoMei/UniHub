# UniHub v2 Environment Example (never commit real secrets!)
HOST=127.0.0.1
PORT=14000
UNIHUB_ORIGIN=https://hub.example.com
UNIHUB_REGION=cn
UNIHUB_CURRENCY=CNY

DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/unihub_v2_cn
UNIHUB_SESSION_KEY=CHANGE_TO_32_BYTE_BASE64URL_KEY
UNIHUB_OPERATOR_SUBJECTS=["operator_oidc_subject"]

LOGTO_ISSUER=https://auth.example.com/oidc
LOGTO_CLIENT_ID=CHANGE_ME
LOGTO_CLIENT_SECRET=CHANGE_ME

# Internal gateway billing protocol & optional key cache sync
UNIHUB_GATEWAY_SERVICE_TOKEN=CHANGE_TO_RANDOM_SECRET
UNIHUB_ALLOWED_GATEWAY_VERSIONS=1.0,1.1
# UNIHUB_FX_RATES_JSON={"USD":"7.20"}
# LLMROUTER_ADMIN_URL=http://127.0.0.1:13010
# LLMROUTER_ADMIN_TOKEN=CHANGE_ME

# Background workers (disable only in tests or single-shot jobs)
UNIHUB_WORKER_ENABLED=true
UNIHUB_OUTBOX_INTERVAL_MS=5000
UNIHUB_HOLD_RECONCILE_INTERVAL_MS=30000
UNIHUB_RENEWAL_INTERVAL_MS=60000
UNIHUB_CREDIT_EXPIRE_INTERVAL_MS=60000

# Optional Lago OSS invoice sync
LAGO_ENABLED=false
# LAGO_API_URL=http://127.0.0.1:18781
# LAGO_API_KEY=CHANGE_ME

# Keep false in production; true only in isolated staging without real merchant keys
UNIHUB_ALLOW_SANDBOX_SETTLE=false

# Outbound + Webhook provider credentials (CN: wechat + alipay, US: stripe)
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_CERT_SERIAL=
# WECHAT_PRIVATE_KEY=
# WECHAT_APIV3_KEY=
# WECHAT_PLATFORM_SERIAL=
# WECHAT_PLATFORM_PUBLIC_KEY=
# WECHAT_NOTIFY_URL=https://hub.example.com/api/webhooks/payments/wechat
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://hub.example.com/api/webhooks/payments/alipay
# ALIPAY_RETURN_URL=https://hub.example.com/console/wallet
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://hub.example.com/console/wallet
# STRIPE_CANCEL_URL=https://hub.example.com/console/wallet
