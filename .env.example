# Documentation only. Run make dev-setup to generate .local/dev.env with
# fresh secrets. Do not use placeholder values or commit generated files.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8088
DATABASE_URL=postgresql://unihub:GENERATED_LOCALLY@127.0.0.1:55438/unihub?sslmode=disable
LEDGER_URL=http://127.0.0.1:53068
LEDGER_NAME=unihub
OIDC_ISSUER=http://localhost:58000
OIDC_AUDIENCE=unihub-local
PAYMENT_MODE=sandbox
PAYMENT_MERCHANT=unihub-sandbox
PAYMENT_SIGNING_KEY=GENERATED_LOCALLY_AT_LEAST_32_BYTES

# Compose/bootstrap values are also generated in .local/dev.env.
POSTGRES_ADMIN_USER=unihub
POSTGRES_ADMIN_PASSWORD=GENERATED_LOCALLY
LEDGER_POSTGRES_URI=postgresql://unihub:GENERATED_LOCALLY@unihub-dev-postgres:5432/ledger?sslmode=disable
CASDOOR_DATABASE_PASSWORD=GENERATED_LOCALLY
LOCAL_GID=GENERATED_FROM_CURRENT_USER
