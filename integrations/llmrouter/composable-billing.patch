+			hub.responseVersion = nil
+			hub.mu.Unlock()
+			require.NoError(t, a.Recover(ctx))
+			require.NoError(t, db.First(&row).Error)
+			assert.Equal(t, "RELEASED", row.Status)
+			hub.mu.Lock()
+			assert.Equal(t, 1, hub.reserveCount)
+			assert.Equal(t, 1, hub.releaseCount)
+			hub.mu.Unlock()
+		})
