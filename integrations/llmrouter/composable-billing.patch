+			case "rate_asset":
+				hub.responseRateAsset = "CREDIT/6"
+			case "mode":
+				hub.responseMode = "credits"
+			case "funder":
+				hub.responseFunder = "product"
+			case "profile_version":
+				otherVersion := 2
+				hub.responseVersion = &otherVersion
+			}
+			hub.mu.Unlock()
+			ctx := context.Background()
+			_, err := a.Admit(ctx, "uh_model_token", "task", "call", []byte(`{"model":"test","max_tokens":50}`))
