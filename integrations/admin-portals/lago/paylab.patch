diff --git a/src/core/router/appBase.ts b/src/core/router/appBase.ts
new file mode 100644
index 000000000..e374d1ffa
--- /dev/null
+++ b/src/core/router/appBase.ts
@@ -0,0 +1,14 @@
+// Vite defines this only for the separately built UniHub entry. Keep root and Jest defaults.
+declare const LAGO_FRONT_BASE_PATH: string
+
+export const appBase = typeof LAGO_FRONT_BASE_PATH === 'string' ? LAGO_FRONT_BASE_PATH : '/'
+export const appPrefix = appBase.slice(0, -1)
+
+// React Router adds its basename to Links and navigate(). Use this only at browser URL boundaries.
+export const browserPath = (path: string): string =>
+  path.startsWith('/') && !path.startsWith('//') ? appPrefix + path : path
+
+export const routerPath = (pathname: string): string =>
+  pathname.startsWith(appBase) ? pathname.slice(appPrefix.length) : pathname
+
+export const storageKey = (key: string): string => appPrefix ? `${appPrefix}:${key}` : key
