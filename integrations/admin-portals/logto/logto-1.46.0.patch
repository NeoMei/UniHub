diff --git a/packages/experience/src/shared/portal-oidc-client.ts b/packages/experience/src/shared/portal-oidc-client.ts
new file mode 100644
index 000000000..7c9b9af21
--- /dev/null
+++ b/packages/experience/src/shared/portal-oidc-client.ts
@@ -0,0 +1,41 @@
+import BrowserClient from '@logto/browser';
+
+/** Validate discovery before the native SDK uses an endpoint or verifies the ID token. */
+export default class PortalOidcClient extends BrowserClient {
+  override readonly getOidcConfig = this.withPinnedIssuer();
+
+  private withPinnedIssuer(): BrowserClient['getOidcConfig'] {
+    const discover = this.getOidcConfig.bind(this);
+    const issuer = new URL(this.logtoConfig.endpoint.replace(/\/$/, '') + '/oidc');
+    if (issuer.protocol !== 'https:' || issuer.origin !== window.location.origin) {
+      throw new Error('Invalid portal issuer');
+    }
+    return async () => {
+      const metadata = await discover();
+      if (metadata.issuer !== issuer.href) {
+        throw new Error('Unexpected portal issuer');
+      }
+      for (const value of [
+        metadata.jwksUri,
+        metadata.authorizationEndpoint,
+        metadata.tokenEndpoint,
+        metadata.revocationEndpoint,
+        metadata.userinfoEndpoint,
+        metadata.endSessionEndpoint,
+      ]) {
+        const url = new URL(value);
+        if (
+          url.origin !== issuer.origin ||
+          !url.pathname.startsWith(issuer.pathname + '/') ||
+          url.username ||
+          url.password ||
+          url.hash ||
+          url.search
+        ) {
+          throw new Error('Unexpected portal OIDC endpoint');
+        }
+      }
+      return metadata;
+    };
