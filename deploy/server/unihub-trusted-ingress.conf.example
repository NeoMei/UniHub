# Optional HTTPS-vhost snippet; this .example file is never included automatically.
# Replace the placeholder with the exact TCP peer IP observed at the origin.
# First verify that this ingress overwrites caller-supplied X-Real-IP with the
# actual client IP. Never trust a wildcard, subnet, hostname or arbitrary client.
# Install ONE reviewed unihub-trusted-ingress-<name>.conf; see README.md.
set_real_ip_from <TRUSTED_INGRESS_IP>;
real_ip_header X-Real-IP;
real_ip_recursive off;
